# Used by Docker Compose when connecting to an existing MongoDB deployment (for example, Atlas).
# For the local MongoDB container, use docker-compose.local-mongo.yml instead.
MONGO_URI=

# Generate a unique, private value for each environment. Never use this example value.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins accepted by the backend.
FRONTEND_URL=http://localhost:5173

BACKEND_PORT=5000
FRONTEND_PORT=5173
